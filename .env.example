# Kopjoje këtë file si .env.local dhe vendos vlerat nga Supabase
# (Project Settings → API Keys / Data API). .env.local NUK shkon në git.
# Përdor vetëm "Publishable key", asnjëherë "Secret key".
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
